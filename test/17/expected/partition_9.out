---
--- GPU-PreAgg with JOIN
---
explain (costs off)
select c_city,s_city,(lo_orderdate/10000)::int d_year,sum(lo_revenue) as revenue
  from customer,plineorder,supplier
 where lo_custkey = c_custkey
   and lo_suppkey = s_suppkey
   and (c_city='UNITED KI1' or c_city='UNITED KI5')
   and (s_city='UNITED KI1' or s_city='UNITED KI5')
   and lo_orderdate between 19930701 and 19960630
 group by 1,2,3
 order by 3 asc, 2 desc;
                                                            QUERY PLAN                                                            
----------------------------------------------------------------------------------------------------------------------------------
 Finalize GroupAggregate
   Group Key: ((plineorder.lo_orderdate / 10000)), supplier.s_city, customer.c_city
   ->  Gather Merge
         Workers Planned: 2
         ->  Partial GroupAggregate
               Group Key: ((plineorder.lo_orderdate / 10000)), supplier.s_city, customer.c_city
               ->  Sort
                     Sort Key: ((plineorder.lo_orderdate / 10000)), supplier.s_city DESC, customer.c_city
                     ->  Hash Join
                           Hash Cond: (plineorder.lo_suppkey = supplier.s_suppkey)
                           ->  Hash Join
                                 Hash Cond: (plineorder.lo_custkey = customer.c_custkey)
                                 ->  Parallel Append
                                       ->  Parallel Custom Scan (GpuScan) on plineorder_p1995_heap plineorder_7
                                             GPU Projection: lo_orderdate, lo_revenue, lo_custkey, lo_suppkey
                                             GPU Scan Quals: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                       ->  Parallel Custom Scan (GpuScan) on plineorder_p1994_heap plineorder_4
                                             GPU Projection: lo_orderdate, lo_revenue, lo_custkey, lo_suppkey
                                             GPU Scan Quals: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                       ->  Parallel Custom Scan (GpuScan) on plineorder_p1993_heap plineorder_1
                                             GPU Projection: lo_orderdate, lo_revenue, lo_custkey, lo_suppkey
                                             GPU Scan Quals: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                             Brin Quals: (lo_orderdate >= 19930701), (lo_orderdate <= 19960630)
                                       ->  Parallel Custom Scan (GpuScan) on plineorder_p1996_heap plineorder_10
                                             GPU Projection: lo_orderdate, lo_revenue, lo_custkey, lo_suppkey
                                             GPU Scan Quals: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                             Brin Quals: (lo_orderdate >= 19930701), (lo_orderdate <= 19960630)
                                       ->  Parallel Foreign Scan on plineorder_p1996_parquet plineorder_11
                                             Filter: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19930701), (lo_orderdate <= 19960630)
                                             file0: plineorder_p1996_rem1.parquet (read: 3353.48KB, size: 10.46MB)
                                       ->  Parallel Foreign Scan on plineorder_p1995_parquet plineorder_8
                                             Filter: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19930701), (lo_orderdate <= 19960630)
                                             file0: plineorder_p1995_rem1.parquet (read: 3351.45KB, size: 10.46MB)
                                       ->  Parallel Foreign Scan on plineorder_p1994_parquet plineorder_5
                                             Filter: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19930701), (lo_orderdate <= 19960630)
                                             file0: plineorder_p1994_rem1.parquet (read: 3340.83KB, size: 10.42MB)
                                       ->  Parallel Foreign Scan on plineorder_p1993_parquet plineorder_2
                                             Filter: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19930701), (lo_orderdate <= 19960630)
                                             file0: plineorder_p1993_rem1.parquet (read: 3336.79KB, size: 10.40MB)
                                       ->  Parallel Foreign Scan on plineorder_p1996_arrow plineorder_12
                                             Filter: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19930701), (lo_orderdate <= 19960630)
                                             file0: plineorder_p1996_rem2.arrow (read: 3573.80KB, size: 21.70MB)
                                       ->  Parallel Foreign Scan on plineorder_p1995_arrow plineorder_9
                                             Filter: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19930701), (lo_orderdate <= 19960630)
                                             file0: plineorder_p1995_rem2.arrow (read: 3573.23KB, size: 21.69MB)
                                       ->  Parallel Foreign Scan on plineorder_p1994_arrow plineorder_6
                                             Filter: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19930701), (lo_orderdate <= 19960630)
                                             file0: plineorder_p1994_rem2.arrow (read: 3563.60KB, size: 21.64MB)
                                       ->  Parallel Foreign Scan on plineorder_p1993_arrow plineorder_3
                                             Filter: ((lo_orderdate >= 19930701) AND (lo_orderdate <= 19960630))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19930701), (lo_orderdate <= 19960630)
                                             file0: plineorder_p1993_rem2.arrow (read: 3550.37KB, size: 21.56MB)
                                 ->  Hash
                                       ->  Custom Scan (GpuScan) on customer
                                             GPU Projection: c_city, c_custkey
                                             GPU Scan Quals: ((c_city = 'UNITED KI1'::bpchar) OR (c_city = 'UNITED KI5'::bpchar))
                           ->  Hash
                                 ->  Custom Scan (GpuScan) on supplier
                                       GPU Projection: s_city, s_suppkey
                                       GPU Scan Quals: ((s_city = 'UNITED KI1'::bpchar) OR (s_city = 'UNITED KI5'::bpchar))
(75 rows)

