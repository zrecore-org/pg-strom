                                       ->  Parallel Foreign Scan on plineorder_p1992_arrow plineorder_2
                                             Filter: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630) AND (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[])))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19920701), (lo_orderdate <= 19970630)
                                             file0: plineorder_p1992_rem2.arrow (read: 4824.11KB, size: 21.58MB)
                                       ->  Parallel Foreign Scan on plineorder_p1993_arrow plineorder_4
                                             Filter: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630) AND (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[])))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19920701), (lo_orderdate <= 19970630)
                                             file0: plineorder_p1993_rem2.arrow (read: 4818.36KB, size: 21.56MB)
                                       ->  Parallel Foreign Scan on plineorder_p1997_arrow plineorder_12
                                             Filter: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630) AND (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[])))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19920701), (lo_orderdate <= 19970630)
                                             file0: plineorder_p1997_rem2.arrow (read: 4808.82KB, size: 21.51MB)
                                 ->  Hash
                                       ->  Custom Scan (GpuScan) on customer
                                             GPU Projection: c_city, c_custkey
                                             GPU Scan Quals: ((c_city = 'UNITED KI1'::bpchar) OR (c_city = 'UNITED KI5'::bpchar))
                           ->  Hash
                                 ->  Custom Scan (GpuScan) on supplier
                                       GPU Projection: s_city, s_suppkey
                                       GPU Scan Quals: ((s_city = 'UNITED KI1'::bpchar) OR (s_city = 'UNITED KI5'::bpchar))
