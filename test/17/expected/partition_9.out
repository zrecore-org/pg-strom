--- only heap and arrow by partition pruning
---
explain (costs off)
select c_city,s_city,(lo_orderdate/10000)::int d_year,lo_shipmode, sum(lo_revenue) as revenue
  from customer,plineorder,supplier
 where lo_custkey = c_custkey
   and lo_suppkey = s_suppkey
   and (c_city='UNITED KI1' or c_city='UNITED KI5')
   and (s_city='UNITED KI1' or s_city='UNITED KI5')
   and lo_orderdate between 19920701 and 19970630
   and lo_shipmode in ('SHIP','RAIL')
 group by 1,2,3,4
 order by 3 asc, 2 desc;
                                                                            QUERY PLAN                                                                             
-------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Finalize GroupAggregate
   Group Key: ((plineorder.lo_orderdate / 10000)), supplier.s_city, customer.c_city, plineorder.lo_shipmode
   ->  Gather Merge
         Workers Planned: 2
         ->  Partial GroupAggregate
               Group Key: ((plineorder.lo_orderdate / 10000)), supplier.s_city, customer.c_city, plineorder.lo_shipmode
               ->  Sort
                     Sort Key: ((plineorder.lo_orderdate / 10000)), supplier.s_city DESC, customer.c_city, plineorder.lo_shipmode
                     ->  Hash Join
                           Hash Cond: (plineorder.lo_suppkey = supplier.s_suppkey)
                           ->  Hash Join
                                 Hash Cond: (plineorder.lo_custkey = customer.c_custkey)
                                 ->  Parallel Append
                                       ->  Parallel Custom Scan (GpuScan) on plineorder_p1996_heap plineorder_9
                                             Filter: (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[]))
                                             GPU Projection: lo_orderdate, lo_shipmode, lo_revenue, lo_custkey, lo_suppkey
                                             GPU Scan Quals: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630))
                                       ->  Parallel Custom Scan (GpuScan) on plineorder_p1995_heap plineorder_7
                                             Filter: (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[]))
                                             GPU Projection: lo_orderdate, lo_shipmode, lo_revenue, lo_custkey, lo_suppkey
                                             GPU Scan Quals: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630))
                                       ->  Parallel Custom Scan (GpuScan) on plineorder_p1994_heap plineorder_5
                                             Filter: (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[]))
                                             GPU Projection: lo_orderdate, lo_shipmode, lo_revenue, lo_custkey, lo_suppkey
                                             GPU Scan Quals: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630))
                                       ->  Parallel Custom Scan (GpuScan) on plineorder_p1993_heap plineorder_3
                                             Filter: (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[]))
                                             GPU Projection: lo_orderdate, lo_shipmode, lo_revenue, lo_custkey, lo_suppkey
                                             GPU Scan Quals: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630))
                                       ->  Parallel Custom Scan (GpuScan) on plineorder_p1997_heap plineorder_11
                                             Filter: (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[]))
                                             GPU Projection: lo_orderdate, lo_shipmode, lo_revenue, lo_custkey, lo_suppkey
                                             GPU Scan Quals: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630))
                                             Brin Quals: (lo_orderdate >= 19920701), (lo_orderdate <= 19970630)
                                       ->  Parallel Custom Scan (GpuScan) on plineorder_p1992_heap plineorder_1
                                             Filter: (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[]))
                                             GPU Projection: lo_orderdate, lo_shipmode, lo_revenue, lo_custkey, lo_suppkey
                                             GPU Scan Quals: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630))
                                             Brin Quals: (lo_orderdate >= 19920701), (lo_orderdate <= 19970630)
                                       ->  Parallel Foreign Scan on plineorder_p1996_arrow plineorder_10
                                             Filter: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630) AND (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[])))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19920701), (lo_orderdate <= 19970630)
                                             file0: plineorder_p1996_rem2.arrow (read: 4850.16KB, size: 21.70MB)
                                       ->  Parallel Foreign Scan on plineorder_p1995_arrow plineorder_8
                                             Filter: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630) AND (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[])))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19920701), (lo_orderdate <= 19970630)
                                             file0: plineorder_p1995_rem2.arrow (read: 4849.38KB, size: 21.69MB)
                                       ->  Parallel Foreign Scan on plineorder_p1994_arrow plineorder_6
                                             Filter: ((lo_orderdate >= 19920701) AND (lo_orderdate <= 19970630) AND (lo_shipmode = ANY ('{SHIP,RAIL}'::bpchar[])))
                                             referenced: lo_custkey, lo_suppkey, lo_orderdate, lo_revenue
                                             Stats-Hint: (lo_orderdate >= 19920701), (lo_orderdate <= 19970630)
