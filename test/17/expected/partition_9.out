explain (costs off)
select lo_orderpriority, sum(lo_extendedprice*lo_discount) as revenue
  from plineorder
 where lo_orderdate between 19930101 and 19931231
   and lo_discount between 1 and 3
   and lo_quantity < 25
 group by lo_orderpriority
 order by lo_orderpriority,revenue;
                                                                                                       QUERY PLAN                                                                                                        
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Incremental Sort
   Sort Key: plineorder.lo_orderpriority, (sum((plineorder.lo_extendedprice * plineorder.lo_discount)))
   Presorted Key: plineorder.lo_orderpriority
   ->  Finalize GroupAggregate
         Group Key: plineorder.lo_orderpriority
         ->  Gather Merge
               Workers Planned: 2
               ->  Sort
                     Sort Key: plineorder.lo_orderpriority
                     ->  Partial HashAggregate
                           Group Key: plineorder.lo_orderpriority
                           ->  Parallel Append
                                 ->  Parallel Custom Scan (GpuScan) on plineorder_p1993_heap plineorder_1
                                       GPU Projection: lo_orderpriority, lo_extendedprice, lo_discount
                                       GPU Scan Quals: ((lo_orderdate >= 19930101) AND (lo_orderdate <= 19931231) AND (lo_discount >= '1'::numeric) AND (lo_discount <= '3'::numeric) AND (lo_quantity < '25'::numeric))
                                 ->  Parallel Foreign Scan on plineorder_p1993_parquet plineorder_2
                                       Filter: ((lo_orderdate >= 19930101) AND (lo_orderdate <= 19931231) AND (lo_discount >= '1'::numeric) AND (lo_discount <= '3'::numeric) AND (lo_quantity < '25'::numeric))
                                       referenced: lo_orderdate, lo_orderpriority, lo_quantity, lo_extendedprice, lo_discount
                                       Stats-Hint: (lo_orderdate >= 19930101), (lo_orderdate <= 19931231), (lo_discount >= '1'::numeric), (lo_discount <= '3'::numeric), (lo_quantity < '25'::numeric)
                                       file0: plineorder_p1993_rem1.parquet (read: 2421.68KB, size: 10.40MB)
                                 ->  Parallel Foreign Scan on plineorder_p1993_arrow plineorder_3
                                       Filter: ((lo_orderdate >= 19930101) AND (lo_orderdate <= 19931231) AND (lo_discount >= '1'::numeric) AND (lo_discount <= '3'::numeric) AND (lo_quantity < '25'::numeric))
                                       referenced: lo_orderdate, lo_orderpriority, lo_quantity, lo_extendedprice, lo_discount
                                       Stats-Hint: (lo_orderdate >= 19930101), (lo_orderdate <= 19931231)
                                       file0: plineorder_p1993_rem2.arrow (read: 8.30MB, size: 21.56MB)
(25 rows)

