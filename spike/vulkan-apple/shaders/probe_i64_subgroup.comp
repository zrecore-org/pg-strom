#version 450
// 64-bit sum without 64-bit atomics: int64 subgroup reduction, then a
// lo/hi pair of 32-bit atomics with explicit carry.
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_subgroup_extended_types_int64 : require

layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer Rows { uint8_t d[]; } rows;
layout(std430, set = 0, binding = 1) buffer Acc { uint lo; uint hi; uint dummy; } acc;
layout(push_constant) uniform PC { uint nrows; uint stride; int64_t thresh; } pc;

uint ld32(uint o)
{
	return uint(rows.d[o]) | (uint(rows.d[o + 1]) << 8) |
		   (uint(rows.d[o + 2]) << 16) | (uint(rows.d[o + 3]) << 24);
}

void main()
{
	uint gid = gl_GlobalInvocationID.x;
	int64_t v = 0;

	if (gid < pc.nrows)
	{
		uint base = gid * pc.stride;
		uint blo = ld32(base + 4);
		uint bhi = ld32(base + 8);
		v = int64_t(uint64_t(blo) | (uint64_t(bhi) << 32));
	}
	int64_t s = subgroupAdd(v);
	if (subgroupElect())
	{
		uint64_t u = uint64_t(s);
		uint lo = uint(u);
		uint hi = uint(u >> 32);
		uint old = atomicAdd(acc.lo, lo);
		uint carry = (old + lo < old) ? 1u : 0u;
		atomicAdd(acc.hi, hi + carry);
	}
}
