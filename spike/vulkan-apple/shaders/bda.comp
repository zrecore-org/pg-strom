#version 450
// Buffer device address: write through a raw pointer passed in push constants.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(buffer_reference, scalar, buffer_reference_align = 4) buffer U32Ptr { uint v[]; };
layout(push_constant) uniform PC { U32Ptr p; uint n; } pc;
layout(local_size_x = 256) in;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i < pc.n)
		pc.p.v[i] = i * 3u + 1u;
}
